# ===== 虚拟环境 =====
.venv/
venv/
ENV/
/.codely
/.codely-cli/

# ===== IDE配置文件 =====
.idea/
.vscode/

# ===== Python缓存 =====
__pycache__/
*.pyc
*.pyo
*.pyd

# ===== 输出结果文件夹（视频、截图检测结果） =====
output/

# ===== YOLO预训练权重文件，忽略官方pt模型 =====
*.pt
# 如果你后续有自己训练的模型需要提交，可以改成不忽略，例如：
# !./weights/my_best.pt

# ===== 结构化结果输出 =====
results/

# ===== 运行时状态 =====
task_status.json

# ===== AI 工作记忆（不属于项目代码） =====
/.workbuddy

# ===== 日志、临时文件 =====
*.log
*.tmp

# ===== 配置（可选：config.yaml要不要提交？）=====
# config.yaml 属于项目配置文件！！建议提交到仓库，不要忽略
.workbuddy/memory/2026-08-21.md
build/
dist/

# ===== PyInstaller 打包配方文件（每次打包自动生成） =====
*.spec
